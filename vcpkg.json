{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "builtin-baseline": "533a5fda5c0646d1771345fb572e759283444d5f",
  "dependencies": [
    "zlib",
    "glm",
    "gli",
    {
      "name": "freetype",
      "platform": "!windows"
    },
    {
      "name": "fontconfig",
      "platform": "!(windows | emscripten | ios)"
    },
    {
      "name": "curl",
      "platform": "!emscripten",
      "features": ["ssl", "websockets"]
    },
    {
      "name": "gamenetworkingsockets",
      "platform": "!(osx | emscripten | ios)"
    },
    {
      "name": "ffmpeg",
      "platform": "ios",
      "features": ["avcodec", "avformat", "swscale", "swresample"]
    },
    "stb"
  ],
  "features": {
    "ffmpeg": {
      "description": "Use FFmpeg instead of Bink for video rendering",
      "dependencies": [ "ffmpeg" ]
    }
  },
  "overrides": [
    {
      "name": "ffmpeg",
      "version": "8.1.1",
      "port-version": 2
    },
    {
      "name": "ffmpeg-bin2c",
      "version": "8.1.1"
    }
  ]
}
